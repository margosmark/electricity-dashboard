# Credentials for the DMD refresh on .110 — TEMPLATE ONLY.
#
# Copy to this directory as `.env`, fill in the values, then:
#     chmod 600 .env
# `.env` is gitignored (root .gitignore) and lives outside the Docker build
# context (which is ./webapp), so neither the repo nor the image can carry it.
# dmd_refresh.py refuses to start if the file is group/world readable or
# tracked by git.
#
# Never commit the filled-in file. Never echo these values in chat, logs or
# ticket comments.

DMD_USERNAME=
DMD_PASSWORD=

# Optional overrides (defaults shown). Paths are on .110.
#DMD_INBOX=/home/hermes/electricity-data/inbox
#DMD_STATE_DIR=/home/hermes/electricity-data/state
#DMD_LOG_DIR=/home/hermes/electricity-data/logs
#DMD_FAIL_DIR=/home/hermes/electricity-data/failed
#DMD_START_URL=https://greenbutton.oakvillehydro.com/
