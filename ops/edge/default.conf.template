# Edge router — the single listener this host exposes for the domain.
#
# The upstream edge (origin VPS 96.44.170.134) forwards EVERY path of
# electricity.markarslan.ca to this box on host port 3939, so the
# "/greenbutton/* lives on its own container" requirement is implemented
# here instead of in an edge config we cannot reach:
#
#   /greenbutton…          → greenbutton-shim   (OAuth client secret + token file)
#   /account/internal/…    → DENIED here (403). The shim→account fan-out runs
#                            on the docker network only; this path must never
#                            be reachable from the internet.
#   /account/…             → account-server     (password verifiers, VAPID key)
#   everything else        → energy-dashboard   (no secrets at all)
#
# Rendered by the nginx image's template entrypoint: ${XFP} is substituted
# from the container environment, $host/$remote_addr/... are left alone
# because they are not environment variables.
#
# Two headers, answering two DIFFERENT questions — do not read one for the
# other:
#
#   X-Edge-Location: greenbutton|account|account-deny|default   which location
#                                                block matched, i.e. which
#                                                branch of THIS file ran
#                                                i.e. which branch of THIS
#                                                file ran
#   x-gb-process:    shim|account|app             which container actually
#                                                produced the body, set by
#                                                the process from its own
#                                                config (config.ts
#                                                getProcessIdentity) — this
#                                                is the one a proxy cannot
#                                                fake for you
#
# They must agree (`greenbutton`↔`shim`, `account`↔`account`, `default`↔`app`).
# A response where they disagree is the split being inverted, which is exactly
# what happened in production on 2026-10-07 (H1): X-Edge-Upstream was emitted
# per location, so it read `shim` while the app container was answering.
#
# Wave N adds a third pair for the same reason: `/account/*` must be answered
# by the container that holds the verifiers, never by the public app.

# `?code=` and `?state=` on the OAuth callback are CREDENTIALS, not
# telemetry: RFC 6749 §4.1.2 makes a code single-use and short-lived, but it
# is still token material and it must not sit in a log next to a request the
# default `main` format would echo in full ($request includes the query
# string). This scope inherits the same file, so the two differ only in what
# they record — path instead of path+query.
log_format gb_noquery '$remote_addr [$time_local] "$uri" $status';

server {
  listen 80;
  server_name _;

  # Docker's embedded DNS, re-read every 10s.
  #
  # nginx resolves a literal `server <name>` inside an `upstream` block ONCE,
  # at config load, and never again — so when a container is recreated with a
  # new IP while the router keeps running, the router keeps talking to
  # whichever container now holds the old address. That inverted the split in
  # production (the secret-bearing shim ended up serving the public dashboard
  # and the secret-less app ran the OAuth flow) and it stays inverted until
  # somebody remembers to restart nginx.
  #
  # With `resolver` + a VARIABLE in proxy_pass, nginx resolves the name per
  # request instead (TTL 10s), so a recreated upstream is picked up on its
  # own. It also lets the router start before its upstreams exist: a missing
  # name now yields a 502 on the affected request rather than refusing to
  # start.
  resolver 127.0.0.11 valid=10s ipv6=off;

  # Per-request upstreams. Host:port only — deliberately no scheme, no path:
  # `proxy_pass http://$gb_shim;` then passes the ORIGINAL request URI
  # through untouched (the variable form does no location-prefix rewriting,
  # so /greenbutton/status arrives as /greenbutton/status).
  set $gb_app     energy-dashboard:3000;
  set $gb_shim    greenbutton-shim:3000;
  set $gb_account account-server:3000;

  # /import accepts a pasted XML export; give it room.
  client_max_body_size 64m;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto ${XFP};

  # The Green Button shim: OAuth2 handshake + the ESPI pipe-through.
  # proxy_buffering OFF on purpose — /greenbutton/usage streams the custodian's
  # feed to the browser byte for byte instead of holding it in nginx memory.
  location /greenbutton {
    proxy_pass http://$gb_shim;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 300s;
    # Log the path only: `$uri` drops the query string, so a canary
    # `?code=…&state=…` can never reach the docker json log. Verified by
    # webapp/scripts/e2e-greenbutton-topology.sh.
    access_log /var/log/nginx/access.log gb_noquery;
    add_header X-Edge-Location greenbutton always;
  }

  # Wave N — the internal fan-out the Green Button shim calls over the
  # docker network when Oakville says new data exists. Denied HERE, so the
  # only way to reach it is the compose network: even with a stolen
  # ACCT_INTERNAL_TOKEN the path does not exist from the internet.
  #
  # Declared BEFORE /account so it is obviously not part of the public API.
  location /account/internal {
    # UNCONDITIONALLY denied — no `allow` list. The shim reaches the account
    # server directly on the compose network (`ACCT_NOTIFY_URL`), never
    # through nginx, so nothing legitimate arrives here. An allow list keyed
    # on source IP would be wrong twice over: docker egress is the host, and
    # a local reverse proxy makes every external request look like 127.0.0.1.
    deny all;
    # No proxy_pass: a denied request must never reach an upstream.
    add_header X-Edge-Location account-deny always;
  }

  # Wave N — the account API. Same two-header contract as the other splits.
  location /account {
    proxy_pass http://$gb_account;
    add_header X-Edge-Location account always;
  }

  # Everything else — the dashboard itself.
  location / {
    proxy_pass http://$gb_app;
    add_header X-Edge-Location default always;
  }
}
