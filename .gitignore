# Environments
.venv/
node_modules/
.next/

# Python Cache
__pycache__/
*.pyc

# Local Data (Crucial: Keep your energy data private)
webapp/.data/
*.xml

# Green Button shim — OAuth token set (never readings, never committed).
# Mounted into the container at /var/lib/greenbutton; owner uid 1001.
.greenbutton/
webapp/.greenbutton/

# Wave N: the account server's SQLite file (ciphertext, but user data).
# Mounted at .account/accounts.db by docker-compose.yml; never committed.
.account/
webapp/.account/

# Exception: the e2e fixture is SYNTHETIC data generated by
# webapp/tests (no real meter readings), safe to commit.
!webapp/tests/fixtures/*.xml
# Same for the DMD test fixture (ops/dmd/tests) — synthetic readings only.
!ops/dmd/tests/fixtures/*.xml

# DMD refresh credentials (ops/dmd/.env) — never committed, never in an image.
# `.env` above already covers it; this is the loud, findable line.
ops/dmd/.env
# Exception: the bundled example export behind "Try with example data"
# (Wave H item 1) — synthetic, generated by
# webapp/scripts/generate-example-fixture.mjs. Still never commit a real
# meter export; this exception covers exactly one directory.
!webapp/public/samples/*.xml

# Kanban worktree isolation (one worktree per card)
.worktrees/

# Misc
.DS_Store
.env
.streamlit/

# Evidence files that contain REAL meter data (backup exports) — never commit.
evidence/*.local.json

# Evidence screenshots never live on main: the pixels moved to the
# `evidence-assets` branch and the `evidence-screenshots-2026-10-11`
# release asset (t_1f93f985). The verification JSON and the notes stay
# tracked — the records are the evidence, the pictures are illustration.
# See evidence/ASSETS.md.
evidence/**/*.png
evidence/**/*.jpg
evidence/**/*.jpeg
evidence/**/*.webp
