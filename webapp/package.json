{
  "name": "webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "node scripts/bump-sw-version.mjs && node scripts/bump-build-info.mjs",
    "start": "next start",
    "preview": "bash scripts/preview-prod.sh",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:theme": "bash scripts/e2e-theme-regression.sh",
    "lighthouse": "lhci autorun",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "date-fns": "^4.1.0",
    "fast-xml-parser": "5.12.0",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.8.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10",
    "eslint-config-next": "16.4.5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "tailwindcss": "^4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "basic-ftp": "6.2.2",
    "source-map-js": "^1.2.2",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "src/**/*.{ts,tsx}": [
      "npm run typecheck"
    ]
  }
}
